        "questionPadding": "15",
        "questionMargin": "0",
        "answerPadding": "15",
        "answerMargin": "0",
        "sectionPaddingTop": "20",
        "sectionPaddingBottom": "20",
        "sectionPaddingLeft": "20",
        "sectionPaddingRight": "20"
      }
